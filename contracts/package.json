{
  "name": "contracts",
  "private": true,
  "version": "0.1.0",
  "description": "LostAndFound escrow contract (Hardhat 3, viem, node:test)",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "gas": "hardhat test --gas-stats",
    "node": "hardhat node",
    "export-abi": "hardhat run scripts/export-abi.ts",
    "typecheck": "hardhat build --quiet && tsc --noEmit",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.2",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.3",
    "@nomicfoundation/ignition-core": "^3.1.10",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.19.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.18.1",
    "typescript": "~6.0.3",
    "viem": "^2.57.2"
  }
