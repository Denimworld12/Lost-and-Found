# Every variable the project uses. Names only, never values.
# Contract secrets (SEPOLIA_RPC_URL, SEPOLIA_PRIVATE_KEY, ETHERSCAN_API_KEY) live in the
# Hardhat keystore: `pnpm --filter contracts exec hardhat keystore set NAME`.
# Web values go in apps/web/.env.local (git-ignored) or Vercel env vars.

# Contracts / server (Hardhat keystore; SEPOLIA_RPC_URL also on Vercel server)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Chain (public)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=
NEXT_PUBLIC_SUBGRAPH_URL=

# IPFS (Pinata)
NEXT_PUBLIC_PINATA_GATEWAY=
PINATA_JWT=

# Verifier wallet (server only; never the deployer)
VERIFIER_PRIVATE_KEY=

# Database (Neon pooled connection string)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=

# App (ALLOWED_EMAIL_DOMAIN: college domain; list extra domains or subdomains comma-separated)
ALLOWED_EMAIL_DOMAIN=
NEXT_PUBLIC_SITE_URL=

# Monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
